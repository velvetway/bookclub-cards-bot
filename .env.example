# Токен от @BotFather
BOT_TOKEN=

# ID администраторов через запятую. Если пусто — первый, кто нажмёт /start, станет админом.
ADMIN_IDS=

# Чат для объявлений о раздаче, опционально. Для супергрупп ID начинается с -100.
GROUP_CHAT_ID=

# Файл базы
DB_PATH=data/bot.db

# Часовой пояс для дат в сообщениях
TZ=Europe/Moscow

# Сколько последних выдач участнику блокируют повтор карты
NO_REPEAT_WINDOW=10

# Через сколько раздач участнику снова может выпасть оптика
OPTICS_COOLDOWN=3

# Рероллов на участника в одной раздаче, 0 — выключено
REROLLS_PER_DEAL=1

# Каталог для логов
LOG_DIR=logs
